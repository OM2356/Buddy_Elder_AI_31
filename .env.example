# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configured Gemini model identifier (e.g., gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# JWT_SECRET: Strong secret used to sign authentication tokens (required in production).
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_64_CHAR_HEX_SECRET"

# BACKUP_ENCRYPTION_SECRET: Distinct strong secret for AES-256-GCM encrypted backups (required in production).
BACKUP_ENCRYPTION_SECRET="REPLACE_WITH_DISTINCT_STRONG_RANDOM_64_CHAR_HEX_SECRET"

# ALLOWED_ORIGINS: Comma-separated allowed CORS origins in production.
ALLOWED_ORIGINS="http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (default 3000).
PORT=3000
